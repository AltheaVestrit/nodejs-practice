<!DOCTYPE html>
<html lang="en">

<%- include('./partials/head') %>
<%- include('./partials/header') %>

<body>
    <div class="container">
        <h2>Books in inventory:</h2>
        <h3>Genres</h3>
        <% Object.keys(genres) != 0 && genres.forEach(genre => { %>
        <a href="/genre/<%=genre.genre_id%>"><%= genre.genre %></a>
        <% }); %>
        <h3>Authors</h3>
        <% Object.keys(authors) != 0 && authors.forEach(author => { %>
        <a href="/author/<%=author.author_id%>"><%= author.author %></a>
        <% }); %>
        <% Object.keys(books) != 0 && books.forEach(book => { %>
        <p><%= book.title %> - <%= book.author %> - <%= book.genre %></p>
        <% }); %>
    </div>
</body>

<%- include('./partials/footer') %>

</html>